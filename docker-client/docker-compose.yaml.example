# Example only. Run ./setup.sh to generate docker-compose.yaml.
services:
  lab1:
    build:
      context: .
      dockerfile: Dockerfile
    image: remote-management-client:latest
    container_name: reverse-ssh-client-lab1
    restart: unless-stopped
    ports:
      - "9000:9000"
      - "9001:9001"
      - "9002:9002"
    environment:
      OPS_USER: "${OPS_USER:-ops}"
      LAB_NAME: "lab1"
      REMOTE_SSH_PORT: "9001"
      REMOTE_UI_PORT: "9002"
      MONITOR_INTERVAL: "${MONITOR_INTERVAL:-5}"
    volumes:
      - "./authorized_keys:/config/authorized_keys:ro"
      - lab1-ssh-host-keys:/etc/ssh/host-keys
    healthcheck:
      test: ["CMD-SHELL", "sshd -t && pgrep -x sshd >/dev/null"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

volumes:
  lab1-ssh-host-keys:
